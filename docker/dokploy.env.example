# Paste into Dokploy → (this application) → Environment, then fill in the blanks.
# Docker/Dokploy keep everything after "=" as the value: no comments on value lines, no quotes
# needed, no ${VAR} expansion.
# Database hosts: the "Internal Host" Dokploy shows for each database (Internal Credentials).

APP_NAME=PromptEdit
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://your-domain.example

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Postgres (Dokploy database)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Dragonfly (Dokploy database, Redis-compatible). REDIS_PASSWORD is required: Dokploy's Dragonfly
# asks for it (otherwise "NOAUTH Authentication required"). Alternatively set only
# REDIS_URL=redis://default:<password>@<internal-host>:6379, which takes precedence.
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=promptedit-
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# No email verification: sign-up works without a mailer. Set a real one (smtp, resend...) only if
# you want password-reset emails delivered.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME=PromptEdit

# Pixelforge: a SEPARATE key for production, with its own webhook URL and secret.
# Webhook URL in the Pixelforge dashboard: https://your-domain.example/webhooks/pixelforge
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_MARKUP_PERCENT=25
# Images are copied to /app/storage/app: mount a volume there (Advanced → Mounts).
PIXELFORGE_IMAGE_DISK=local
