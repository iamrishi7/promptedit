# Paste into Dokploy → (this compose) → Environment, then fill in the blanks.
# Hostnames: the "Internal Host" Dokploy shows for each database.

APP_NAME="PromptEdit"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate --show
APP_URL=https://your-domain.example

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Postgres (Dokploy database)
DB_CONNECTION=pgsql
DB_HOST=                       # internal host, e.g. promptedit-db-abc123
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Dragonfly (Dokploy database, Redis-compatible)
REDIS_CLIENT=phpredis
REDIS_HOST=                    # internal host, e.g. promptedit-dragonfly-abc123
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=promptedit-
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Sign-up needs email verification: use a real mailer (SMTP, Resend, Postmark...).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Pixelforge: a SEPARATE key for production, with its own webhook URL and secret.
# Webhook URL in the Pixelforge dashboard: https://your-domain.example/webhooks/pixelforge
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_MARKUP_PERCENT=25
# Images are copied to /app/storage/app, a named volume shared by app and worker.
PIXELFORGE_IMAGE_DISK=local
